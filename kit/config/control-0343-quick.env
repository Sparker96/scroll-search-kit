# control-0343-quick.env — a quick try of the kit on PHerc. 0343, the public scroll whose first letters are already
# known (Erwin Nieuwlaar, First Letters prize, October 2026): the same 2 cm band as control-0343.env with a small
# growth budget and 2 strips per box, for a much shorter run (⟨time: from the release-candidate test⟩). It also seeds
# six of the known letters and starts strips there (a letter that no strip reaches gets the patch grown there inked
# instead), so its ink maps can be checked for them: a positive control from seed to map. Results:
# ~/results/PHerc0343-quick.
#   bash ~/work/run.sh ~/kit/config/control-0343-quick.env
# A config is plain shell assignments, read with `.`: keep it to KEY=value lines.

S=PHerc0343
B=https://vesuvius-challenge-open-data.s3.us-east-1.amazonaws.com
VOL_URL=$B/PHerc0343/volumes/20250521140437-8.640um-1.2m-116keV-masked.zarr
PRED_URL=$B/PHerc0343/representations/predictions/surfaces/20250521140437-surface-20260413222639-surface-m7-L0-th0.2.zarr
VOXEL_UM=8.64
UMBILICUS=umbilici/PHerc0343_umbilicus.json   # scroll axis by Erwin Nieuwlaar (MIT, see NOTICE.md), shipped in the kit
UMBILICUS_URL=https://raw.githubusercontent.com/Nieuwlaar/pherc343-first-letters/e8370f1f88a211166056df62ea6fcfffe4a1063e/inputs/umbilicus_PHerc0343.json
UMBILICUS_SHA256=e05a0a6237462de6f1930e7c7c2f468846869f3617a1798a528c69c047cd0ebe   # fetched from his repo if missing
BANDS="9250:11300"
# letters 1, 4, 6, 9, 12 and 16 (positions from Erwin Nieuwlaar's letter boxes, MIT, see NOTICE.md), on the prediction
SEEDS_EXTRA=seeds/PHerc0343_letters.tsv

# ink model: Reader V3 (Domenico Russo, MIT), pinned revision + checksum. For Reader v2 instead:
#   MODEL_URL=https://huggingface.co/domenicor046/reader-v2/resolve/72633d8aa6d40e9e737ccea4c9928fbc624dab45/reader-v2-step040000.pth
#   MODEL_SHA256=654ec5acec2b6c4788d9cb326e2f0b8c2c730584949a934ef775db7f6ab5d3a6
#   PREFIX=rv2  MODEL_DEPTH=17  BATCH_SIZE=16
MODEL_URL=https://huggingface.co/domenicor046/reader-v3/resolve/aee1d64bced4eb35546348f3d276b9e2a0b99c46/reader-v3.pth
MODEL_SHA256=ea405417450abd8ace1b8ff79ebce3adb646c5e48ab95da46844d77efe984d8a
PREFIX=rv3
MODEL_DEPTH=17
BATCH_SIZE=4       # V3 reads 384x384-pixel patches (v2: 128x128); 4 fits a 12 GB GPU

# quick-try settings
RUN_NAME=PHerc0343-quick
NEXP1=60
NEXP2=60
GROW1_MAX=900
GROW2_MAX=600
NTR=2
MAXTRY=4
GRID=2
