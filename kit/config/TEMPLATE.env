# TEMPLATE.env — every setting the kit reads, with its default. Copy to <scroll>.env, fill in the REQUIRED block,
# and change anything else only if you have a reason. A config is plain shell assignments read with `.`.
#   bash ~/work/run.sh ~/kit/config/<scroll>.env

# ---- REQUIRED: the scroll ----
S=                      # scroll id as in the open-data bucket, e.g. PHerc0343
VOL_URL=                # OME-Zarr scan volume (the *masked* one), level 0 is read
PRED_URL=               # OME-Zarr surface prediction for that volume; its normal grids must sit next to it
# NORMAL_GRIDS_URL=${PRED_URL%.zarr}.normal-grids   # where those normal grids are, if not next to it
VOXEL_UM=               # voxel size in um (9.362 for the 1.2 m / 113 keV scans, 8.64 for PHerc0343's)
UMBILICUS=              # scroll axis, JSON {"control_points": [{"x","y","z"}, ...]}; relative = next to this file
# UMBILICUS_URL=        # where to download the axis file if it is not there yet (+ UMBILICUS_SHA256=)
BANDS=                  # z ranges to search, "z0:z1 z0:z1 ..."; each band is grown, stitched and read in turn

# ---- REQUIRED: the ink model ----
MODEL_URL=              # checkpoint URL (pin a revision); downloaded once, checksum-verified, weights-only checked
MODEL_SHA256=
PREFIX=                 # map file prefix (letters, digits, - and _), e.g. rv3 -> rv3_s<start>[_reverse].tif
# MODEL_DEPTH=          # crop depth in layers, if the checkpoint's config does not record it (Reader v2 and V3: 17)
# BATCH_SIZE=16         # inference batch size: lower it for models that need more GPU memory (Reader V3: 4 on 12 GB)
# The same-answer check reads the control with this model, so the control must hold reference maps made by this
# checkpoint (kit/test/control/ref/<PREFIX>_s*.tif; the kit's control has Reader v2 and Reader V3), or set CHECK=0.
# Known models (pinned, see control-0343.env): Reader V3 (rv3) and Reader v2 (rv2), both by Domenico Russo, MIT.

# ---- where results go ----
# RUN_NAME=$S           # results in RESULTS/RUN_NAME
# RESULTS=$HOME/results

# ---- seeds and boxes (band.sh) ----
# GRID=3                # boxes per side over the scan's x/y extent
# MARGIN=150            # overlap between neighbouring boxes, voxels
# RAYS=16               # seed rays around the axis at the band's middle height
# FRACS="0.15 0.35 0.55 0.75 0.9"   # seed positions along each ray, as fractions of the papyrus radius
# SEEDS_EXTRA=          # your own seed points: a tsv of name x y z rows (relative = next to this file). Those in a
#                       #     band join its seeds, and each box starts its first strips at the patches grown there;
#                       #     a point no strip reaches gets its patch inked as it is (box_*/seeds_extra.ink.tsv)
#                       #     (control-0343-quick.env seeds six known letters, so its maps can be checked for them)
# MASK_CHECK=1          # drop seeds, skip strips and leave out COVER patches that lie outside the scan's mask
#                       #     (no data there: they render empty)

# ---- growth and stitching (box.sh) ----
# (defaults = the settings of the measured rented run, docs/COSTS.md)
# GENS=48               # growth generations per patch
# NEXP1=300 NEXP2=300   # grower launches in pass 1 (tgt_overlap_count 10) and pass 2 (30)
# GROW1_MAX=2400 GROW2_MAX=1800   # seconds after which a pass starts no new growers (0 = no limit)
# GROW_TIMEOUT=1800     # seconds before a single grower is stopped
# NTR=6 MAXTRY=12       # strips to keep per box, tracer attempts per box (coverage: more strips per area); a box
#                       #     gets one more attempt per SEEDS_EXTRA point it holds
# MIN_NEW=0             # percent: a strip adding less new area than this to the box's inked strips is kept but
#                       #     not inked (the rented run's 5th-6th strips added 34-56 %); 0 = off
# COVER=0               # 1 = ink a cover of the grown patches instead of stitched strips (being tested; strips
#                       #     are the default): greedy, most new area first, up to COVER_FRAC of their union.
#                       #     With MASK_CHECK=1, patches less than 80 % inside the scan's mask are left out first
# COVER_FRAC=0.8        # share of the patch cloud's union the picked patches must cover
# DROP_SINGLE=0         # 1 = leave out patches that no other patch comes within 10 voxels of. Not recommended: in
#                       #     an ink test, being seen by no other patch did not predict an empty render
# MINCM=1.0             # smallest strip kept, cm2
# TRACE_TIMEOUT=3600    # seconds before one stitcher run is stopped
# STITCH_THREADS=16     # OpenMP threads per stitcher run
# GROW_NICE=10          # growers and the stitcher run at this nice level (0-19), so ink gets the CPU first
# BANDS_IN_FLIGHT=2     # bands growing at once; all growers share one pool of slots (sized from CPU, RAM, pids.max)
# BAND_TRIES=3 BAND_PAUSE=300   # a failed band is tried again (its boxes resume), BAND_PAUSE x try seconds later
# PASS_PAUSE=60         # pause before retrying a growth pass in which most growers failed
# START_MAX_COVERED=0.2 # a patch can start a new strip while at most this share of it lies on earlier strips
# START_TOL=8           # voxels: closer than this to an earlier strip counts as covered
# START_MIN_AREA=0.5    # cm2: smallest patch that may start a strip

# ---- render and ink (inkq.sh) ----
# NUM_SLICES=61         # layers rendered around each strip
# CENTRES="10 14 18 22 26 30 34 38 42 46 50"   # window centres = depths -20..+20 around the middle layer
# INK_PER_GPU=1         # ink workers per GPU (each needs ~1 GB of GPU memory with Reader v2)
# INK_OMP=8             # CPU threads per ink worker
# INK_NUM_WORKERS=4     # data-loading processes per ink worker: 4 made Reader V3 2.7x faster than 0 on a desktop GPU,
#                       #     with byte-identical maps; 8 added nothing
# RENDER_CACHE_GB=8     # chunk cache per render
# RENDER_RETRIES=1      # fresh renders for a blank or failed render before it is set aside (queue/blank, queue/failed)
# RENDER_TIMEOUT=3600 INK_TIMEOUT=7200   # seconds per strip before the render / ink step is stopped (-> queue/failed)
# GPU_FAIL_MAX=3        # an ink worker stops after this many strips in a row ended with no maps (a broken GPU)
# WORKER_RESTARTS=3     # ... and starts again after WORKER_PAUSE x n seconds, at most this many times (likewise a
# WORKER_PAUSE=300      #     worker that died; its strip goes back to the queue)

# ---- guard rails ----
# CHECK=1               # same-answer check on the control strip before searching
# PREFLIGHT=1           # one window of the configured model on the control strip before searching
# MIN_FREE_GB=150       # workers wait (and alert) below this much free disk (several renders can start at once)
# DISK_WAITS=6          # 5-minute waits for free disk; then the ink workers stop and the run ends with an error
# CACHE_EVICT=0         # 1 = when disk is low, delete the oldest VC3D download-cache files (they are downloaded again
#                       #     when needed). Deletes files on the machine: only with the operator's explicit approval.
# NET_TRIES=8           # tries, pauses 30 s doubling to 5 min (~30 min in all), for network steps
# NET_DOWN_MAX=3600     # seconds the scan may stay unreachable before the ink workers stop the run
# DEL_ZARR=0            # 1 = delete each strip's temporary 61-layer volume (~70 MB per cm2) once its maps are saved
# NODATA=1              # set each map to 0 where its input layers are all 0 (outside the mesh or the scan's mask):
#                       # a model can write strokes there that are not ink (Reader V3 does); 0 = keep raw maps
# NODATA_MARGIN=0       # also this many pixels around such areas (if a model's edge artefacts reach into data)
# GROWER_GB=0.5         # RAM per grower for the grower cap (measured ~0.3 GB each)
# RESERVE_GB=           # RAM kept free for renders and ink [16 + (RENDER_CACHE_GB + 5) x ink workers + 0.5 x their loaders,
#                       #     at most 40 % of RAM]; fewer than 8 grower slots is logged as a WARNING
# RESERVE_THREADS=      # CPU threads kept free for ink [8 + (2 + INK_NUM_WORKERS) x ink workers]
